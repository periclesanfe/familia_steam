# Copie para .env (nunca versionar o .env). Ver docs/spec/08 §8.1.
# App em runtime: papel app_rw (sem ser dono das tabelas, 14 SEG-08)
DATABASE_URL=postgresql://app_rw:app_rw@localhost:5433/consorcio
# Migrações (prisma migrate): papel dono app_owner
MIGRATE_DATABASE_URL=postgresql://app_owner:app_owner@localhost:5433/consorcio
APP_URL=http://localhost:3100
# Chave gratuita em https://steamcommunity.com/dev/apikey (necessária a partir do M3)
STEAM_API_KEY=
# Mínimo de 32 caracteres (openssl rand -base64 48)
CRON_SECRET=
# 1 habilita /api/auth/dev fora de produção
DEV_LOGIN=1
